{
  "name": "@dornach-anthony-coucke/source",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/**/*"
  ],
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all -- --run",
    "clean": "nx run-many -t clean --all -- --run",
    "typecheck": "nx run-many --target=typecheck --all",
    "graph": "nx graph",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-stable": "pnpm run build && changeset publish",
    "publish-dev": "pnpm run build && changeset publish --tag dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@nx/eslint": "22.0.2",
    "@nx/eslint-plugin": "^22.1.1",
    "@nx/js": "22.0.2",
    "@nx/vite": "22.0.2",
    "@nx/web": "22.0.2",
    "@types/node": "24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "^5.3.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jiti": "2.4.2",
    "nx": "22.0.2",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.10",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "e": "^0.2.33"
  }
}
